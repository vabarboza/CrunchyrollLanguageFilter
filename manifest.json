
{
    "manifest_version": 3,
    "name": "Crunchyroll Filter",
    "version": "1.1.0",
    "description": "Hide releases of selected languages on the Crunchyroll calendar.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.crunchyroll.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Crunchyroll Filter",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.crunchyroll.com/pt-br/releasecalendar*",
                "https://www.crunchyroll.com/pt-br/simulcastcalendar*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
